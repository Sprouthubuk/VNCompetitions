---
import PrizeArt from './PrizeArt.astro';
import Countdown from './Countdown.astro';
import { type Comp, money, pct, fmt } from '../data/comps';
import { compHref } from '../lib/url';
interface Props { c: Comp }
const { c } = Astro.props;
const p = pct(c);
const circ = 2 * Math.PI * 25;
const dash = `${Math.max(1.5, (p / 100) * circ).toFixed(1)} ${circ.toFixed(1)}`;
const instant = c.type === 'instant';
const endsSoon = new Date(c.drawAt).getTime() - new Date('2026-11-09T00:00:00Z').getTime() < 4 * 86400000;
const odds = instant ? (c.slug === 'target-takeover' ? 'Every ticket wins' : `${fmt(c.instantCount ?? 0)} prizes`) : `1 in ${fmt(c.max)}`;
---
<article class:list={['card', { instant }]} data-cat={c.category} data-price={c.price} data-mode={c.drawMode} data-ends={endsSoon ? '1' : '0'}>
  <a class="media" href={compHref(c.slug)} aria-label={`${c.title} — view competition`}>
    <PrizeArt kind={c.kind} brand={c.brand} amount={c.amount} />
    <span class="tags">
      <span class="tag"><i class:list={[c.drawMode]}></i>{c.drawMode === 'auto' ? 'Auto draw' : 'Live draw'}</span>
      {endsSoon && !instant && <span class="tag hot">Ends Wed</span>}
      {instant && <span class="tag gold">{fmt(c.instantCount ?? 0)} instant wins</span>}
    </span>
    <span class="price">
      {c.was && <s class="mono">{money(c.was)}</s>}
      <b>{money(c.price)}</b>
      <em class="mono">Per entry</em>
    </span>
    <span class="ring" aria-label={`${p}% sold`}>
      <svg viewBox="0 0 62 62" aria-hidden="true"><circle cx="31" cy="31" r="25" /><circle cx="31" cy="31" r="25" stroke-dasharray={dash} /></svg>
      <span class="mono">{p}%</span>
    </span>
  </a>
  <div class="body">
    <h3 class="d">{c.title}</h3>
    <Countdown to={c.drawAt} size="sm" />
    <div class="meta mono"><span>{fmt(c.sold)} / {fmt(c.max)} sold</span><span>{odds}</span></div>
    <div class="actions">
      <a class="btn btn-green btn-sm enter" href={compHref(c.slug)}>Enter now</a>
      <button type="button" class="plus" data-add={c.slug} data-title={c.title} data-price={c.price} data-qty="5" aria-label={`Quick add 5 tickets for ${c.title}`}>+5</button>
    </div>
  </div>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; background: #0b0c0b; border: 1px solid rgba(21, 212, 107, .28); box-shadow: 0 24px 60px -30px rgba(0, 176, 80, .6); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .card:hover { transform: translateY(-4px); border-color: rgba(21, 212, 107, .6); box-shadow: 0 34px 70px -28px rgba(0, 176, 80, .8); }
  .card.instant { border-color: rgba(255, 200, 61, .45); box-shadow: 0 24px 60px -30px rgba(255, 200, 61, .55); }
  .card.instant:hover { border-color: rgba(255, 200, 61, .8); }
  .card[hidden] { display: none; }
  .media { position: relative; display: block; color: #fff; }
  .media :global(.art) { transition: transform .4s ease; }
  .card:hover .media :global(.art) { transform: scale(1.04); }
  .tags { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .tag { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; border-radius: 8px; background: rgba(5, 5, 5, .72); border: 1px solid rgba(255, 255, 255, .16); font: 700 10px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .tag i { width: 6px; height: 6px; border-radius: 50%; background: var(--red); }
  .tag i.auto { background: #60a5fa; }
  .tag.hot { background: var(--red); border-color: var(--red); color: #fff; }
  .tag.gold { background: var(--gold); border-color: var(--gold); color: #1a1200; }
  .price { position: absolute; left: 12px; bottom: 12px; display: flex; flex-direction: column; align-items: flex-start; padding: 8px 14px 6px; border-radius: 10px; background: var(--green); color: #04140b; transform: skewX(-8deg); box-shadow: 0 10px 30px -8px rgba(0, 176, 80, .8); }
  .instant .price { background: linear-gradient(180deg, var(--gold-hi), var(--gold-lo)); color: #1a1200; box-shadow: 0 10px 30px -8px rgba(255, 200, 61, .7); }
  .price s { font-size: 11px; font-weight: 700; opacity: .7; }
  .price b { font: 400 34px/1 var(--font-display); }
  .price em { font-style: normal; font-size: 9px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin-top: 2px; }
  .ring { position: absolute; right: 12px; bottom: 12px; width: 62px; height: 62px; border-radius: 50%; background: rgba(5, 5, 5, .82); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }
  .ring svg { position: absolute; inset: 0; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 5; stroke: rgba(255, 255, 255, .12); }
  .ring circle + circle { stroke: var(--green-hi); stroke-linecap: round; }
  .instant .ring circle + circle { stroke: var(--gold); }
  .ring span { position: relative; }
  .body { padding: 16px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  h3 { font-size: 21px; line-height: 1.02; min-height: 43px; }
  .meta { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; font-weight: 600; color: var(--muted); }
  .actions { display: flex; gap: 8px; margin-top: auto; }
  .enter { flex: 1; }
  .plus { width: 54px; min-height: 46px; border-radius: 12px; border: 1px solid var(--gold); background: rgba(255, 200, 61, .08); color: var(--gold); font: 400 18px var(--font-display); cursor: pointer; }
  .plus:hover { background: var(--gold); color: #1a1200; }
</style>
