---
import { href, asset } from '../lib/url';
import { getWinners } from '../lib/data';
const winners = await getWinners();
interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [
  { id: 'competitions', label: 'Competitions', to: href('competitions') },
  { id: 'instant', label: 'Instant wins', to: href('competitions') + '#instant' },
  { id: 'winners', label: 'Winners', to: href('winners'), live: true },
  { id: 'free-entry', label: 'Free entry', to: href('free-entry') },
];
const promo = ['Free postal entry on every comp', 'Live draws Wed & Sun on Facebook', 'Every draw publicly verified', '18+ UK only · play responsibly', 'Instant wins from 25p'];
---
<header class="hdr">
  <div class="promo" aria-hidden="true">
    <div class="track">{[...promo, ...promo].map((p) => <span>{p}<i></i></span>)}</div>
  </div>
  <div class="bar">
    <div class="inner wrap">
      <a class="logo" href={href('')} aria-label="Vault Nine Competitions home"><img src={asset('logo.png')} alt="Vault Nine Competitions" width="102" height="60" /></a>
      <nav aria-label="Main">
        {links.map((l) => (
          <a href={l.to} aria-current={active === l.id ? 'page' : undefined}>{l.live && <i class="live"></i>}{l.label}</a>
        ))}
      </nav>
      <div class="right">
        <a class="credit" href={href('basket')} aria-label="Site credit £4.20"><span class="coin">V</span><span class="mono">£4.20</span></a>
        <a class="bag" href={href('basket')} aria-label="Basket">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9h18l-2 11H5L3 9z" /><path d="M8 9l4-6 4 6" /></svg>
          <span class="count mono" data-basket-count>0</span>
        </a>
        <a class="btn btn-sm acct" href={href('basket')}>My account</a>
      </div>
    </div>
  </div>
  <div class="ticker">
    <span class="lbl">Just won</span>
    <div class="track" aria-label="Recent winners">
      {[...winners, ...winners].map((w) => (
        <span><b>{w.name.split(' ')[0]} {w.name.split(' ')[1][0]}.</b> won <em>{w.prize}</em><small class="mono">{w.ticket}</small></span>
      ))}
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 30; background: var(--ink); }
  .promo { background: var(--green); color: #04140b; overflow: hidden; white-space: nowrap; }
  .promo .track { display: inline-flex; animation: v9-marquee 38s linear infinite; padding: 7px 0; font: 400 13px var(--font-display); letter-spacing: .08em; text-transform: uppercase; }
  .promo span { display: inline-flex; align-items: center; gap: 18px; padding: 0 18px; }
  .promo i { width: 7px; height: 7px; background: #04140b; transform: rotate(45deg); }
  .bar { border-bottom: 1px solid rgba(21, 212, 107, .25); background: linear-gradient(180deg, #070907, var(--ink)); }
  .inner { display: flex; align-items: center; gap: 24px; padding-top: 10px; padding-bottom: 10px; }
  .logo img { height: 60px; width: auto; filter: drop-shadow(0 6px 18px rgba(0, 176, 80, .35)); }
  nav { display: flex; gap: 2px; flex: 1; justify-content: center; flex-wrap: wrap; }
  nav a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border-radius: 10px; color: #e4e4e7; font: 400 16px var(--font-display); letter-spacing: .05em; text-transform: uppercase; }
  nav a:hover { color: #fff; background: rgba(255, 255, 255, .05); }
  nav a[aria-current="page"] { background: var(--green-hi); color: #04140b; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 4px rgba(255, 59, 59, .2); animation: v9-pulse 1.4s infinite; }
  .right { display: flex; align-items: center; gap: 10px; }
  .credit { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px 0 8px; border-radius: 999px; background: rgba(255, 200, 61, .08); border: 1px solid rgba(255, 200, 61, .5); color: #fff; font-weight: 700; }
  .coin { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(180deg, var(--gold-hi), #e0a21a); color: #1a1200; display: inline-flex; align-items: center; justify-content: center; font: 400 14px var(--font-display); }
  .bag { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 12px; background: #111311; border: 1px solid rgba(255, 255, 255, .14); color: #fff; }
  .count { position: absolute; top: -7px; right: -7px; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: var(--green); color: #04140b; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 3px var(--ink); }
  .acct { background: #fff; color: var(--ink); }
  .acct:hover { color: var(--ink); background: #e4e4e7; }
  .ticker { display: flex; align-items: center; overflow: hidden; white-space: nowrap; background: #0a0c0a; border-bottom: 1px solid rgba(255, 255, 255, .06); }
  .ticker .lbl { flex: none; position: relative; z-index: 1; display: inline-flex; align-items: center; height: 38px; padding: 0 16px; background: var(--gold); color: #1a1200; font: 400 14px var(--font-display); letter-spacing: .06em; text-transform: uppercase; }
  .ticker .track { display: inline-flex; animation: v9-marquee 60s linear infinite; padding-left: 16px; }
  .ticker span { display: inline-flex; align-items: center; gap: 8px; padding: 0 22px; font-size: 13px; color: var(--dim); border-right: 1px solid rgba(255, 255, 255, .08); }
  .ticker b { color: #fff; } .ticker em { font-style: normal; color: var(--green-soft); font-weight: 700; } .ticker small { color: var(--muted); font-size: 11px; }
  @media (max-width: 980px) {
    nav { display: none; }
    .acct { display: none; }
    .inner { justify-content: space-between; }
    .logo img { height: 46px; }
  }
</style>
