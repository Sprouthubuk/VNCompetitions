---
// Illustrated prize artwork. Swap for real campaign images when available:
// pass `image` and the illustration is replaced by the photo.
import type { PrizeKind } from '../data/comps';
interface Props { kind: PrizeKind; brand: string; amount?: string; image?: string; label?: string }
const { kind, brand, amount = '£100', image, label } = Astro.props;
const uid = 'pa' + Math.random().toString(36).slice(2, 8);
const word = brand.toUpperCase();
const wordSize = word.length > 9 ? 64 : word.length > 6 ? 84 : 108;
const dart = (tx: number, rot: number) => ({ tx, rot });
const darts = [dart(-22, -22), dart(0, 0), dart(22, 22)];
---
<div class="art">
  {image ? (
    <img src={image} alt={label ?? brand} loading="lazy" />
  ) : (
    <svg viewBox="0 0 400 400" role="img" aria-label={label ?? `${brand} prize illustration`}>
      <defs>
        <linearGradient id={`${uid}b`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#15D46B" stop-opacity=".38" /><stop offset="1" stop-color="#15D46B" stop-opacity="0" /></linearGradient>
        <linearGradient id={`${uid}s`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#6B7280" /><stop offset=".35" stop-color="#F4F4F5" /><stop offset=".6" stop-color="#A1A1AA" /><stop offset="1" stop-color="#3F3F46" /></linearGradient>
        <linearGradient id={`${uid}g`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFE08A" /><stop offset="1" stop-color="#E0A21A" /></linearGradient>
        <radialGradient id={`${uid}f`} cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#00B050" stop-opacity=".55" /><stop offset="1" stop-color="#00B050" stop-opacity="0" /></radialGradient>
        <filter id={`${uid}x`} x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="7" /></filter>
      </defs>
      <path d="M60 -10 L150 -10 L230 400 L-40 400 Z" fill={`url(#${uid}b)`} opacity=".55" />
      <path d="M250 -10 L340 -10 L440 400 L170 400 Z" fill={`url(#${uid}b)`} opacity=".4" />
      <text x="200" y="232" text-anchor="middle" transform="rotate(-8 200 200)" font-family="Anton, sans-serif" font-size={wordSize} fill="none" stroke="rgba(255,255,255,.13)" stroke-width="1.6" letter-spacing="2">{word}</text>
      <ellipse cx="200" cy="350" rx="150" ry="26" fill={`url(#${uid}f)`} />
      <g fill="#FFC83D"><circle cx="58" cy="92" r="2" /><circle cx="338" cy="70" r="1.6" /><circle cx="356" cy="214" r="2.2" /><circle cx="40" cy="250" r="1.5" /></g>
      <g fill="#4ADE80"><circle cx="312" cy="118" r="1.8" /><circle cx="70" cy="180" r="1.4" /><circle cx="300" cy="300" r="1.6" /></g>

      {kind === 'darts' && darts.map((d) => (
        <g transform={`rotate(${d.rot} 200 340) translate(${d.tx} ${d.rot === 0 ? -6 : 0})`}>
          <path d="M200 70 L238 128 L200 150 L162 128 Z" fill="#00B050" stroke="#4ADE80" stroke-width="2" />
          <path d="M200 74 L200 150" stroke="#04140B" stroke-width="3" />
          <rect x="196" y="148" width="8" height="54" rx="3" fill="#18181B" stroke="#3F3F46" />
          <rect x="188" y="200" width="24" height="84" rx="10" fill={`url(#${uid}s)`} />
          <g stroke="#3F3F46" stroke-width="2"><line x1="189" y1="222" x2="211" y2="222" /><line x1="189" y1="232" x2="211" y2="232" /><line x1="189" y1="242" x2="211" y2="242" /><line x1="189" y1="252" x2="211" y2="252" /></g>
          <path d="M196 284 L204 284 L201 336 L199 336 Z" fill="#D4D4D8" />
        </g>
      ))}

      {(kind === 'board' || kind === 'ring') && (
        <g>
          {kind === 'ring' ? (
            <>
              <circle cx="200" cy="196" r="150" fill="none" stroke="#00B050" stroke-width="22" opacity=".5" filter={`url(#${uid}x)`} />
              <circle cx="200" cy="196" r="150" fill="none" stroke="#E4E4E7" stroke-width="30" />
              <circle cx="200" cy="196" r="150" fill="none" stroke="#A1A1AA" stroke-width="2" stroke-dasharray="4 10" />
              <circle cx="200" cy="196" r="134" fill="none" stroke="#15D46B" stroke-width="3" stroke-dasharray="2 14" />
            </>
          ) : (
            <circle cx="200" cy="196" r="132" fill="#00B050" opacity=".45" filter={`url(#${uid}x)`} />
          )}
          <circle cx="200" cy="196" r={kind === 'ring' ? 112 : 128} fill="#111" />
          <circle cx="200" cy="196" r="104" fill="none" stroke="#C81E1E" stroke-width="12" /><circle cx="200" cy="196" r="104" fill="none" stroke="#00B050" stroke-width="12" stroke-dasharray="32.67 32.67" />
          <circle cx="200" cy="196" r="80" fill="none" stroke="#EDE6D6" stroke-width="34" /><circle cx="200" cy="196" r="80" fill="none" stroke="#0A0A0A" stroke-width="34" stroke-dasharray="25.13 25.13" />
          <circle cx="200" cy="196" r="58" fill="none" stroke="#C81E1E" stroke-width="10" /><circle cx="200" cy="196" r="58" fill="none" stroke="#00B050" stroke-width="10" stroke-dasharray="18.22 18.22" />
          <circle cx="200" cy="196" r="40" fill="none" stroke="#EDE6D6" stroke-width="26" /><circle cx="200" cy="196" r="40" fill="none" stroke="#0A0A0A" stroke-width="26" stroke-dasharray="12.57 12.57" />
          <circle cx="200" cy="196" r="13" fill="#00B050" /><circle cx="200" cy="196" r="6" fill="#C81E1E" />
        </g>
      )}

      {kind === 'box' && (
        <g>
          <path d="M200 96 L318 150 L318 290 L200 344 L82 290 L82 150 Z" fill="#00B050" opacity=".45" filter={`url(#${uid}x)`} />
          <path d="M82 150 L200 204 L200 344 L82 290 Z" fill="#0F1A13" stroke="#15D46B" stroke-width="3" />
          <path d="M318 150 L200 204 L200 344 L318 290 Z" fill="#0A120D" stroke="#15D46B" stroke-width="3" />
          <path d="M200 96 L318 150 L200 204 L82 150 Z" fill="#173823" stroke="#4ADE80" stroke-width="3" />
          <path d="M141 123 L259 177 L259 317" fill="none" stroke="#FFC83D" stroke-width="10" opacity=".9" />
          <text x="141" y="296" text-anchor="middle" font-family="Anton, sans-serif" font-size="96" fill="#4ADE80" transform="skewY(24) translate(0 -64)">?</text>
        </g>
      )}

      {kind === 'voucher' && (
        <g transform="rotate(-8 200 200)">
          <rect x="58" y="120" width="284" height="164" rx="14" fill="#FFC83D" opacity=".4" filter={`url(#${uid}x)`} />
          <path d="M72 120 H328 a14 14 0 0 1 14 14 V178 a24 24 0 0 0 0 48 V270 a14 14 0 0 1 -14 14 H72 a14 14 0 0 1 -14 -14 V226 a24 24 0 0 0 0 -48 V134 a14 14 0 0 1 14 -14 Z" fill="#111" stroke={`url(#${uid}g)`} stroke-width="4" />
          <line x1="262" y1="132" x2="262" y2="272" stroke="#FFC83D" stroke-width="2" stroke-dasharray="6 8" opacity=".7" />
          <text x="164" y="222" text-anchor="middle" font-family="Anton, sans-serif" font-size="86" fill={`url(#${uid}g)`}>{amount}</text>
          <text x="164" y="254" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="15" font-weight="700" fill="#FFE08A" letter-spacing="4">VOUCHER</text>
          <text x="300" y="210" text-anchor="middle" font-family="Anton, sans-serif" font-size="30" fill="#00B050" transform="rotate(90 300 200)">V9</text>
        </g>
      )}
    </svg>
  )}
</div>

<style>
  .art { position: relative; width: 100%; aspect-ratio: 1 / 1; overflow: hidden; background: radial-gradient(120% 80% at 50% 38%, #0e3a22 0%, #071a10 38%, #050605 72%); }
  .art svg, .art img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; }
</style>
