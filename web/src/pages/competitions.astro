---
import Base from '../layouts/Base.astro';
import CompCard from '../components/CompCard.astro';
import { categories, fmt } from '../data/comps';
import { getComps } from '../lib/data';
const comps = await getComps();
import { href } from '../lib/url';
const instantPrizes = comps.reduce((t, c) => t + (c.instantCount ?? 0), 0);
const cheapest = Math.min(...comps.map((c) => c.price));
---
<Base title="Live competitions" active="competitions">
  <section class="top">
    <div class="beam" aria-hidden="true"></div>
    <div class="wrap head">
      <div><span class="kick"><i></i>{comps.length} live · new drops weekly</span><h1 class="d"><span class="sl">Live</span> <span class="sl g">comps</span></h1></div>
      <div class="stats">
        <div><b class="d gold">{Math.round(cheapest * 100)}p</b><span class="mono">Cheapest ticket</span></div>
        <div><b class="d">{fmt(instantPrizes)}</b><span class="mono">Instant prizes</span></div>
        <div class="hot"><b class="d">{comps.filter((c) => c.type === 'standard').length}</b><span class="mono">Drawn Wednesday</span></div>
      </div>
    </div>
  </section>

  <section class="bar">
    <div class="wrap row">
      <div class="filters" role="group" aria-label="Category">
        <button type="button" class="chip" aria-pressed="true" data-cat="All">All <small>{comps.length}</small></button>
        {categories.map((c) => <button type="button" class="chip" aria-pressed="false" data-cat={c}>{c} <small>{comps.filter((x) => x.category === c).length}</small></button>)}
      </div>
      <div class="toggles">
        <button type="button" class="tg" aria-pressed="false" data-toggle="cheap">Under £1</button>
        <button type="button" class="tg" aria-pressed="false" data-toggle="auto">Auto draw</button>
        <label class="mono sr" for="sort">Sort</label>
        <select id="sort"><option value="end">Ending soonest</option><option value="price">Lowest price</option><option value="odds">Best odds</option></select>
      </div>
    </div>
  </section>

  <section class="list">
    <div class="wrap">
      <p class="empty" hidden>No comps match those filters. Clear one to see more.</p>
      <div class="cards" id="grid">{comps.map((c) => <CompCard c={c} />)}</div>
      <div class="free">
        <div><div class="d"><span class="sl">Enter any comp free by post</span></div><p>Same random ticket, same chance. No limit per person.</p></div>
        <a class="btn btn-white btn-sm" href={href('free-entry')}>Postal entry details</a>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var state = { cat: 'All', cheap: false, auto: false, sort: 'end' };
    var grid = document.getElementById('grid');
    var cards = Array.prototype.slice.call(grid.children);
    var hash = location.hash.replace('#', '');
    if (hash === 'instant') state.cat = 'Instant win';
    if (hash === 'penny') state.cheap = true;
    function apply() {
      document.querySelectorAll('[data-cat]').forEach(function (b) { if (b.tagName === 'BUTTON') b.setAttribute('aria-pressed', b.dataset.cat === state.cat ? 'true' : 'false'); });
      document.querySelectorAll('[data-toggle]').forEach(function (b) { b.setAttribute('aria-pressed', state[b.dataset.toggle] ? 'true' : 'false'); });
      var shown = 0;
      var sorted = cards.slice().sort(function (a, b) {
        if (state.sort === 'price') return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
        if (state.sort === 'odds') return parseFloat(a.querySelector('.meta span').textContent.replace(/[^0-9]/g, '')) - parseFloat(b.querySelector('.meta span').textContent.replace(/[^0-9]/g, ''));
        return parseInt(b.dataset.ends, 10) - parseInt(a.dataset.ends, 10);
      });
      sorted.forEach(function (c) {
        var ok = (state.cat === 'All' || c.dataset.cat === state.cat) && (!state.cheap || parseFloat(c.dataset.price) < 1) && (!state.auto || c.dataset.mode === 'auto');
        c.hidden = !ok; if (ok) shown++; grid.appendChild(c);
      });
      document.querySelector('.empty').hidden = shown > 0;
    }
    document.querySelectorAll('button[data-cat]').forEach(function (b) { b.addEventListener('click', function () { state.cat = b.dataset.cat; apply(); }); });
    document.querySelectorAll('[data-toggle]').forEach(function (b) { b.addEventListener('click', function () { state[b.dataset.toggle] = !state[b.dataset.toggle]; apply(); }); });
    document.getElementById('sort').addEventListener('change', function (e) { state.sort = e.target.value; apply(); });
    apply();
  })();
</script>

<style>
  .top { position: relative; overflow: hidden; padding: 56px 0 36px; background: radial-gradient(50% 90% at 80% 0%, rgba(0, 176, 80, .25), transparent 70%), var(--ink); border-bottom: 1px solid var(--line); }
  .beam { position: absolute; right: 8%; top: -160px; width: 200px; height: 600px; background: linear-gradient(180deg, rgba(21, 212, 107, .3), transparent); transform: rotate(-18deg); filter: blur(16px); }
  .head { position: relative; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  h1 { font-size: clamp(64px, 9vw, 112px); margin-top: 16px; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; min-width: min(420px, 100%); }
  .stats div { padding: 16px; border-radius: 14px; background: #0b0d0b; border: 1px solid var(--line); }
  .stats .hot { border-color: rgba(255, 59, 59, .4); }
  .stats b { display: block; font-size: 34px; } .stats span { display: block; margin-top: 6px; font-size: 11px; letter-spacing: .1em; color: var(--muted); text-transform: uppercase; }
  .bar { position: sticky; top: 158px; z-index: 20; padding: 16px 0; background: rgba(5, 5, 5, .94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .row { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .filters, .toggles { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .tg { min-height: 44px; padding: 0 14px; border-radius: 10px; border: 1px dashed rgba(255, 255, 255, .22); background: transparent; color: var(--dim); font: 700 12px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .tg[aria-pressed="true"] { border-style: solid; border-color: var(--gold); color: var(--gold); background: rgba(255, 200, 61, .08); }
  select { min-height: 44px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, .18); background: #0b0d0b; color: #fff; padding: 0 14px; font: 600 14px var(--font-body); }
  .list { padding: 36px 0 96px; }
  .empty { padding: 48px; text-align: center; border-radius: 20px; border: 1px dashed rgba(255, 255, 255, .18); color: var(--muted); }
  .free { margin-top: 40px; padding: 26px 30px; border-radius: 20px; background: linear-gradient(135deg, var(--green-deep), #062b18); border: 1px solid rgba(21, 212, 107, .4); display: flex; gap: 20px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .free .d { font-size: 32px; } .free p { margin: 6px 0 0; color: #d1fae5; }
  @media (max-width: 980px) { .bar { top: 130px; } }
  @media (max-width: 760px) { .bar { position: static; } .stats { grid-template-columns: repeat(3, 1fr); } .stats b { font-size: 26px; } }
</style>
