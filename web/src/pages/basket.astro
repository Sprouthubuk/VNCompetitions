---
import Base from '../layouts/Base.astro';
import { href, compHref } from '../lib/url';
import { getComps } from '../lib/data';
const comps = await getComps();
const links = Object.fromEntries(comps.map((c) => [c.slug, compHref(c.slug)]));
const types = Object.fromEntries(comps.map((c) => [c.slug, c.type]));
const shop = href('competitions');
---
<Base title="Your basket">
  <section class="sec top">
    <div class="wrap">
      <span class="kick"><i></i>Tickets held for 15 minutes</span>
      <h1 class="d"><span class="sl">Your</span> <span class="sl g">basket</span></h1>
    </div>
  </section>
  <section class="sec" style="padding-top:0">
    <div class="wrap layout">
      <div class="lines">
        <div id="list"></div>
        <div id="empty" class="panel empty" hidden>
          <h2 class="d"><span class="sl">Your basket’s empty</span></h2>
          <p class="muted">Tickets from 25p. Pick a prize and come back.</p>
          <a class="btn btn-green" href={shop}>Browse competitions</a>
        </div>
        <div class="panel limit">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#15D46B" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          <p><b>You've spent £18.40 of your £100 monthly limit.</b> <span class="muted">Change your limits any time in My account, or take a break.</span></p>
        </div>
      </div>
      <aside class="panel panel-glow sum">
        <h2 class="d"><span class="sl">Summary</span></h2>
        <form id="promo" class="promo">
          <label class="sr" for="code">Promo code</label>
          <input id="code" placeholder="Promo code" autocomplete="off" />
          <button class="btn btn-ghost btn-sm" type="submit">Apply</button>
        </form>
        <p id="promo-msg" class="mono msg" hidden></p>
        <label class="credit">
          <input type="checkbox" id="use-credit" />
          <span><b>Use site credit</b><small class="muted">£4.20 available</small></span>
        </label>
        <dl>
          <div><dt class="muted">Tickets</dt><dd class="mono" id="s-count">0</dd></div>
          <div><dt class="muted">Subtotal</dt><dd class="mono" id="s-sub">£0.00</dd></div>
          <div id="r-disc" hidden><dt class="muted">Promo</dt><dd class="mono g" id="s-disc"></dd></div>
          <div id="r-cred" hidden><dt class="muted">Site credit</dt><dd class="mono g" id="s-cred"></dd></div>
        </dl>
        <div class="tot"><span class="mono muted">To pay</span><b class="d" id="s-total">£0.00</b></div>
        <button class="btn btn-green pay" id="pay" type="button">Pay securely</button>
        <p class="fine muted">Card, Apple Pay or Google Pay. Ticket numbers are assigned at random once payment clears. 18+, UK only.</p>
      </aside>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ links, types }}>
  (function () {
    var disc = 0, CREDIT = 4.2;
    var f = function (v) { return '£' + v.toFixed(2); };
    function render() {
      var items = window.V9.items();
      var list = document.getElementById('list');
      document.getElementById('empty').hidden = items.length > 0;
      list.innerHTML = items.map(function (i) {
        var gold = types[i.slug] === 'instant';
        return '<article class="line' + (gold ? ' gold' : '') + '">' +
          '<a class="ti" href="' + (links[i.slug] || '#') + '"><span class="d">' + i.title + '</span><span class="mono muted">' + f(i.price) + ' each' + (gold ? ' · instant win' : '') + '</span></a>' +
          '<div class="step" role="group" aria-label="Quantity for ' + i.title + '"><button type="button" data-d="-1" data-s="' + i.slug + '" aria-label="One fewer">−</button><span class="mono">' + i.qty + '</span><button type="button" data-d="1" data-s="' + i.slug + '" aria-label="One more">+</button></div>' +
          '<b class="d lt">' + f(i.price * i.qty) + '</b>' +
          '<button type="button" class="rm" data-rm="' + i.slug + '" aria-label="Remove ' + i.title + '">×</button></article>';
      }).join('');
      var count = items.reduce(function (t, i) { return t + i.qty; }, 0);
      var sub = items.reduce(function (t, i) { return t + i.qty * i.price; }, 0);
      var d = sub * disc;
      var cr = document.getElementById('use-credit').checked ? Math.min(CREDIT, sub - d) : 0;
      document.getElementById('s-count').textContent = count;
      document.getElementById('s-sub').textContent = f(sub);
      document.getElementById('r-disc').hidden = !d; document.getElementById('s-disc').textContent = '−' + f(d);
      document.getElementById('r-cred').hidden = !cr; document.getElementById('s-cred').textContent = '−' + f(cr);
      document.getElementById('s-total').textContent = f(Math.max(0, sub - d - cr));
      document.getElementById('pay').disabled = !items.length;
    }
    document.getElementById('list').addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b) return;
      var items = window.V9.items();
      if (b.dataset.rm) { window.V9.set(b.dataset.rm, 0); }
      else if (b.dataset.s) { var it = items.find(function (i) { return i.slug === b.dataset.s; }); window.V9.set(b.dataset.s, it.qty + (+b.dataset.d)); }
      render();
    });
    document.getElementById('use-credit').addEventListener('change', render);
    document.getElementById('promo').addEventListener('submit', function (e) {
      e.preventDefault();
      var code = document.getElementById('code').value.trim().toUpperCase(), m = document.getElementById('promo-msg');
      m.hidden = false;
      if (code === 'VIP10') { disc = .1; m.textContent = 'VIP10 applied: 10% off'; m.className = 'mono msg g'; }
      else { disc = 0; m.textContent = 'That code isn’t valid. Try VIP10.'; m.className = 'mono msg red'; }
      render();
    });
    document.getElementById('pay').addEventListener('click', function () { window.V9.toast('Preview only: this hands off to Cashflows checkout'); });
    render();
  })();
</script>

<style>
  .top { padding-bottom: 28px; }
  h1 { font-size: clamp(56px, 8vw, 110px); margin-top: 14px; }
  .layout { display: grid; grid-template-columns: 1fr 400px; gap: 24px; align-items: start; }
  .lines { display: flex; flex-direction: column; gap: 12px; }
  #list { display: flex; flex-direction: column; gap: 12px; }
  :global(.line) { display: grid; grid-template-columns: 1fr auto 110px 40px; gap: 18px; align-items: center; padding: 18px 20px; border-radius: 18px; background: var(--panel); border: 1px solid var(--line); }
  :global(.line.gold) { border-color: rgba(255, 200, 61, .4); }
  :global(.line .ti) { display: flex; flex-direction: column; gap: 4px; color: #fff; }
  :global(.line .ti .d) { font-size: 26px; }
  :global(.line .ti .mono) { font-size: 12px; }
  :global(.line .lt) { font-size: 28px; text-align: right; }
  :global(.step) { display: inline-flex; align-items: center; border: 1px solid rgba(255, 255, 255, .16); border-radius: 12px; overflow: hidden; }
  :global(.step button) { width: 44px; height: 44px; background: #0b0d0b; color: #fff; border: 0; font-size: 20px; cursor: pointer; }
  :global(.step span) { min-width: 44px; text-align: center; font-weight: 700; }
  :global(.rm) { width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: var(--muted); font-size: 22px; cursor: pointer; }
  :global(.rm:hover) { color: var(--red); border-color: var(--red); }
  .empty { padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .empty h2 { font-size: 40px; }
  .limit { display: flex; gap: 14px; align-items: center; padding: 16px 20px; }
  .limit p { margin: 0; font-size: 14px; line-height: 1.5; }
  .sum { padding: 26px; display: flex; flex-direction: column; gap: 16px; position: sticky; top: 170px; }
  .sum h2 { font-size: 40px; }
  .promo { display: flex; gap: 8px; }
  .promo input { flex: 1; min-height: 46px; padding: 0 14px; border-radius: 12px; background: #050605; border: 1px solid rgba(255, 255, 255, .16); color: #fff; font: 600 15px var(--font-mono); text-transform: uppercase; }
  .msg { margin: -6px 0 0; font-size: 12px; }
  .credit { display: flex; gap: 12px; align-items: center; padding: 14px 16px; border-radius: 14px; background: rgba(255, 200, 61, .06); border: 1px solid rgba(255, 200, 61, .3); cursor: pointer; }
  .credit input { width: 20px; height: 20px; accent-color: var(--gold); }
  .credit span { display: flex; flex-direction: column; } .credit small { font-size: 12px; }
  dl { margin: 0; } dl div { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--line); } dl div[hidden] { display: none; } dt, dd { margin: 0; } dd { font-weight: 700; }
  .tot { display: flex; justify-content: space-between; align-items: baseline; }
  .tot .mono { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; } .tot b { font-size: 56px; line-height: 1; }
  .pay { width: 100%; min-height: 60px; font-size: 22px; } .pay:disabled { opacity: .4; cursor: not-allowed; }
  .fine { margin: 0; font-size: 12px; line-height: 1.5; }
  @media (max-width: 1060px) { .layout { grid-template-columns: 1fr; } .sum { position: static; } }
  @media (max-width: 760px) { :global(.line) { grid-template-columns: 1fr auto; } :global(.line .lt) { text-align: left; } }
</style>
