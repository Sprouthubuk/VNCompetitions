---
import Base from '../layouts/Base.astro';
import CompCard from '../components/CompCard.astro';
import PrizeArt from '../components/PrizeArt.astro';
import Countdown from '../components/Countdown.astro';
import { categories, fmt, money, isOpen, isSoldOut, everyTicketWins } from '../data/comps';
import { getComps, getWinners } from '../lib/data';
const [comps, winners] = await Promise.all([getComps(), getWinners()]);
import { href, compHref, asset } from '../lib/url';

const featured = comps.find((c) => c.type === 'instant' && isOpen(c)) ?? comps.find((c) => c.type === 'instant') ?? comps[0];
const instants = comps.filter((c) => c.type === 'instant');
const standard = comps.filter((c) => c.type === 'standard');
const openStandard = standard.filter(isOpen);
const ending = (openStandard.length ? openStandard : standard).slice(0, 4);
const instantPrizes = instants.reduce((t, c) => t + (c.instantCount ?? 0), 0);
const quickPool = comps.filter((c) => c.price <= 2 && isOpen(c)).slice(0, 4).map((c) => ({ slug: c.slug, title: c.title, price: c.price, max: c.type === 'instant' ? 0 : c.max }));
const tilt = [-3, 2, -1.5, 3, -2, 1.5];
const lights = [
  { x: 6, c: 'rgba(21,212,107,.5)', t: 7, d: 0, from: -28, to: 18 },
  { x: 20, c: 'rgba(255,255,255,.34)', t: 9, d: -3, from: 20, to: -22 },
  { x: 34, c: 'rgba(255,200,61,.36)', t: 8, d: -1, from: -18, to: 24 },
  { x: 50, c: 'rgba(21,212,107,.5)', t: 6, d: -2, from: -14, to: 14 },
  { x: 66, c: 'rgba(255,200,61,.36)', t: 8, d: -5, from: 24, to: -18 },
  { x: 80, c: 'rgba(255,255,255,.34)', t: 9, d: -4, from: -22, to: 20 },
  { x: 94, c: 'rgba(21,212,107,.5)', t: 7, d: -2, from: 18, to: -28 },
];
const gerbs = [5, 14, 86, 95];
const pinned = comps.filter((c) => c.featured);
const slides = (pinned.length ? pinned : comps).slice(0, 4);
const steps = [
  { n: '01', t: 'Pick your prize', d: 'Choose a comp and your tickets. Bundles, Buy X get Y and multipliers get you more for less.' },
  { n: '02', t: 'Get your numbers', d: 'Random ticket numbers land in your account the moment you pay. Instant wins reveal straight away.' },
  { n: '03', t: 'Watch the draw', d: 'Live on Facebook or automatically on the minute, with a public proof for every result.' },
];
---
<Base title="Win premium darts gear" active="home">
  <!-- HERO: the main stage -->
  <section class="show" data-show>
    <div class="s-bg" aria-hidden="true">
      <div class="led"><img class="led-logo" src={asset('logo.png')} alt="" width="640" height="376" /></div>
      <div class="truss"></div>
      <div class="lights">
        {lights.map((l) => <i class="mh" style={`--x:${l.x}%;--c:${l.c};--t:${l.t}s;--d:${l.d}s;--from:${l.from}deg;--to:${l.to}deg`}><b></b></i>)}
      </div>
      <div class="haze hz1"></div><div class="haze hz2"></div>
      <div class="embers" data-embers="46"></div>
      <div class="s-floor"></div>
      {gerbs.map((x) => <span class="gerb" data-gerb style={`left:${x}%`}></span>)}
      <div class="s-fade"></div>
    </div>

    <div class="wrap s-in">
      <div class="s-top">
        <span class="kick"><i></i>Live · {comps.length} comps open · next draw Wed 21:30</span>
        <h1 class="d"><span class="sl">Game</span> <span class="sl g">on.</span></h1>
        <p class="tag">Darts, boards and auto-scorers from the brands you throw. Tickets from <b class="gold mono">25p</b>.</p>
      </div>

      <div class="slides" data-slides>
        {slides.map((c, i) => {
          const inst = c.type === 'instant';
          const open = isOpen(c);
          const p = Math.round((c.sold / c.max) * 100);
          return (
            <article class:list={['slide', { 'is-on': i === 0, inst }]} data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="s-info">
                <div class="s-tags">
                  {isSoldOut(c) && <span class="kick" style="background:#fff;color:var(--ink);border-color:#fff">Sold out</span>}
                  {inst ? <span class="kick is-gold" style="background:var(--gold);color:#1a1200;border-color:var(--gold)">Instant win</span> : <span class="kick"><i></i>{c.drawMode === 'auto' ? 'Auto draw' : 'Live draw'}</span>}
                  {inst ? <span class="kick is-gold">{fmt(c.instantRemaining ?? 0)} prizes left</span> : <span class="kick is-gold">Cash alternative</span>}
                </div>
                <h2 class="d"><span class:list={['sl', inst ? 'gold' : '']}>{c.title}</span></h2>
                <div class="s-price">
                  <div class:list={['ptag', { gold: inst }]}>{c.was && <s class="mono">{money(c.was)}</s>}<b>{money(c.price)}</b><span class="mono">{inst ? 'Per spin' : 'Per entry'}</span></div>
                  <div class="s-meter">
                    <div class="mono"><b>{p}%</b> sold · {fmt(c.max - c.sold)} left</div>
                    <div class="bar"><span style={`width:${Math.max(3, p)}%`}></span></div>
                  </div>
                </div>
                <Countdown to={c.drawAt} size="md" tone={inst ? 'gold' : 'green'} />
                <div class="s-cta">
                  <a class:list={['btn', inst ? 'btn-gold' : 'btn-green']} href={compHref(c.slug)}>{open ? (inst ? 'Spin to win' : 'Enter now') : 'Sold out · view draw'} →</a>
                  {open && <button type="button" class="btn plus5" data-add={c.slug} data-title={c.title} data-price={c.price} data-qty="5" aria-label={`Quick add 5 to ${c.title}`}>+5</button>}
                </div>
              </div>
              <a class="s-art" href={compHref(c.slug)} tabindex="-1">
                <span class="s-ring" aria-hidden="true"></span>
                <span class="s-frame"><PrizeArt kind={c.kind} brand={c.brand} amount={c.amount} /><i class="shine" aria-hidden="true"></i></span>
              </a>
            </article>
          );
        })}
      </div>

      <div class="rail">
        <button type="button" class="rbtn" data-step="-1" aria-label="Previous">‹</button>
        <div class="thumbs">
          {slides.map((c, i) => (
            <button type="button" class:list={['thumb', { on: i === 0, inst: c.type === 'instant' }]} data-go={i}>
              <span class="tart"><PrizeArt kind={c.kind} brand={c.brand} amount={c.amount} /></span>
              <span class="ttx"><b class="d">{c.title}</b><span class="mono">{money(c.price)}</span></span>
              <i class="tbar"></i>
            </button>
          ))}
        </div>
        <button type="button" class="rbtn" data-step="1" aria-label="Next">›</button>
      </div>
    </div>
  </section>

  <!-- INSTANT STRIP + QUICK TILES -->
  <section class="quick">
    <div class="wrap">
      {featured?.type === 'instant' && (
        <a class="strip" href={compHref(featured.slug)}>
          <span class="num gold">{fmt(featured.instantRemaining ?? 0)}</span>
          <span class="strip-txt"><span class="kick is-gold"><i></i>Live</span><span class="d"><span class="sl">Instant prizes still up for grabs</span></span><span class="muted">Across {featured.title}. {everyTicketWins(featured) ? 'Every ticket wins something.' : `${fmt(featured.instantRemaining ?? 0)} instant prizes left.`}</span></span>
          <span class="btn btn-gold btn-sm">Win one now →</span>
        </a>
      )}
      <div class="qtiles">
        <a class="qt" href={href('competitions')}><b class="d">{comps.length}</b><span class="d">All comps</span><small class="mono g">Live now</small><span class="qa" aria-hidden="true"><PrizeArt kind="board" brand="All" /></span></a>
        <a class="qt hot" href={href('competitions') + '#ending'}><b class="d">{standard.length}</b><span class="d">Ending soon</span><small class="mono" style="color:#ff8a8a">Wed 21:30</small><span class="qa" aria-hidden="true"><PrizeArt kind="box" brand="Soon" /></span></a>
        <a class="qt" href={href('competitions') + '#penny'}><b class="d">{comps.filter((c) => c.price < 1).length}</b><span class="d">Penny plays</span><small class="mono g">From 25p</small><span class="qa" aria-hidden="true"><PrizeArt kind="darts" brand="25p" /></span></a>
        <a class="qt gold-t" href={href('competitions') + '#instant'}><b class="d">{instants.length}</b><span class="d">Instant wins</span><small class="mono gold">{fmt(instantPrizes)} prizes</small><span class="qa" aria-hidden="true"><PrizeArt kind="ring" brand="Win" /></span></a>
      </div>
    </div>
  </section>

  <!-- ENDING SOON -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="kick" style="color:#ff8a8a;border-color:rgba(255,59,59,.5)"><i></i>Drawn Wed 21:30</span><h2 class="d"><span class="sl">Last</span> <span class="sl red">orders</span></h2></div>
        <div style="min-width:260px"><Countdown to={ending[0].drawAt} size="sm" seconds={false} /></div>
      </div>
      <div class="cards">{ending.map((c) => <CompCard c={c} />)}</div>
    </div>
  </section>

  <!-- INSTANT ARCADE -->
  <section class="sec arcade" id="instant">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="kick is-gold">Instant win arcade</span><h2 class="d"><span class="sl">Win it</span> <span class="sl gold">on the spot</span></h2></div>
        <p class="muted" style="max-width:440px;margin:0;line-height:1.6">Winning tickets are placed at random and sealed before launch. Pay, then throw, spin or flip to find out what you've won.</p>
      </div>
      <div class="arcade-grid">
        {instants.map((w) => (
          <article class="panel panel-gold game">
            <a href={compHref(w.slug)} class="game-art"><PrizeArt kind={w.kind} brand={w.brand} /><span class="kick is-gold game-tag">{w.game === 'wheel' ? 'Spin the wheel' : 'Dartboard throw'}</span></a>
            <div class="game-body">
              <h3 class="d"><span class="sl">{w.title}</span></h3>
              <div class="mono" style="font-size:13px;color:var(--dim)"><b class="gold" style="font-size:18px">{fmt(w.instantRemaining ?? 0)}</b> of {fmt(w.instantCount ?? 0)} prizes left · {money(w.price)} a go</div>
              <ul class="ladder">
                {(w.instantPrizes ?? []).slice(0, 3).map((p) => (
                  <li><div><span>{p.name}</span><span class="mono gold">{p.left} / {p.total}</span></div><i><b style={`width:${Math.round((p.left / p.total) * 100)}%`}></b></i></li>
                ))}
              </ul>
              <a class="btn btn-gold btn-sm" href={compHref(w.slug)}>Play now</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ALL COMPS -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><div><span class="kick is-green"><i style="background:var(--green-hi)"></i>{comps.length} live now</span><h2 class="d"><span class="sl">Pick your</span> <span class="sl g">prize</span></h2></div></div>
      <div class="filters" role="group" aria-label="Filter competitions">
        <button type="button" class="chip" aria-pressed="true" data-filter="All">All</button>
        {categories.map((c) => <button type="button" class="chip" aria-pressed="false" data-filter={c}>{c}</button>)}
      </div>
      <div class="cards" id="grid">{comps.map((c) => <CompCard c={c} />)}</div>
      <div style="display:flex;justify-content:center;margin-top:36px"><a class="btn btn-ghost" href={href('competitions')}>See every competition</a></div>
    </div>
  </section>

  <!-- QUICK PICK -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="panel panel-gold qp">
        <div class="qp-l">
          <span class="kick is-gold">Quick pick</span>
          <h2 class="d"><span class="sl">Set a budget.</span><br /><span class="sl gold">We'll fill the board.</span></h2>
          <p class="muted">Pick how much to spend and we'll spread whole tickets across tonight's comps for the best mix of odds. You review it before paying.</p>
          <div class="amts" role="group" aria-label="Budget">
            {[5, 10, 20, 50].map((v) => <button type="button" class="amt" aria-pressed={v === 10 ? 'true' : 'false'} data-amt={v}>£{v}</button>)}
          </div>
        </div>
        <div class="qp-r">
          <div class="mono muted" style="font-size:12px;letter-spacing:.14em">YOUR SPREAD · <span id="qp-budget">£10</span></div>
          <ul id="qp-list"></ul>
          <div class="qp-tot"><span class="mono" id="qp-tix"></span><span class="d" id="qp-spent" style="font-size:34px"></span></div>
          <button type="button" class="btn btn-green" id="qp-add">Add spread to basket</button>
        </div>
      </div>
    </div>
  </section>

  <!-- CREW -->
  <section class="sec crew">
    <div class="wrap crew-grid">
      <div class="hosts">
        {[['Liam', 'Host · draws'], ['Whisk', 'Host · banter'], ['Simon', 'Host · unboxings']].map(([n, r], i) => (
          <figure class="host" style={i === 1 ? 'transform:translateY(-24px)' : ''}>
            <div class="host-ph"><svg viewBox="0 0 120 150" aria-hidden="true"><circle cx="60" cy="52" r="26" fill="#1C221C" stroke="#15D46B" stroke-width="2" /><path d="M14 150c4-34 22-52 46-52s42 18 46 52z" fill="#1C221C" stroke="#15D46B" stroke-width="2" /></svg><span class="mono">Host photo</span></div>
            <figcaption><b class="d">{n}</b><span class="mono muted">{r}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="crew-copy">
        <span class="kick"><i></i>Live on Facebook</span>
        <h2 class="d"><span class="sl">Pull up a stool.</span><br /><span class="sl g">We draw live.</span></h2>
        <p>The V9 crew draws every live comp in the Facebook group on Wednesday and Sunday nights at 21:30. Banter, unboxings, and every winning ticket checked on screen against its proof.</p>
        <div class="ctas"><a class="btn btn-green btn-sm" href="https://www.facebook.com/vaultninecompetitions">Join 4,200+ in the group</a><a class="btn btn-ghost btn-sm" href={href('winners')}>Past results</a></div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="sec">
    <div class="wrap">
      <div class="panel panel-glow proof">
        <div class="proof-l">
          <span class="kick is-green">Verity draw proof</span>
          <h2 class="d"><span class="sl">Every draw comes</span><br /><span class="sl g">with a receipt.</span></h2>
          <p>Before a draw we seal the entry list and lock in a secret seed. After it, we reveal the seed, so anyone can re-run the draw and land on the same ticket. Other sites ask you to trust them. We show the maths.</p>
          <div class="ctas"><a class="btn btn-green btn-sm" href={href('winners')}>See a proof</a><a class="btn btn-ghost btn-sm" href={href('winners')}>Check my ticket</a></div>
        </div>
        <div class="proof-r">
          <div class="mono muted" style="font-size:12px;letter-spacing:.14em">PICK YOUR BOARD · DRAW #458 · EXAMPLE</div>
          <div class="row"><span class="muted">Entries sealed</span><span class="mono">999 tickets</span></div>
          <div class="row"><span class="muted">Entry list fingerprint</span><span class="mono">9f2c…e41a</span></div>
          <div class="row"><span class="muted">Seed locked</span><span class="mono">3b7d…08c5</span></div>
          <div class="row win"><span class="d" style="font-size:22px">Winning ticket</span><span class="d g" style="font-size:52px">#0417</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WINNERS WALL -->
  <section class="sec" style="padding-top:24px;overflow:hidden">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="kick is-gold">The wall</span><h2 class="d"><span class="sl">Real</span> <span class="sl gold">winners</span></h2></div>
        <div style="text-align:right"><div class="d gold" style="font-size:76px"><span class="sl">457</span></div><div class="mono muted" style="font-size:12px;letter-spacing:.14em">DRAWS · 170 DIFFERENT WINNERS · <a href={href('winners')}>ALL RESULTS →</a></div></div>
      </div>
      <div class="wall">
        {winners.slice(0, 6).map((w, i) => (
          <figure class="polaroid" style={`transform:rotate(${tilt[i]}deg)`}>
            <div class="ph"><span class="d">{w.name.split(' ').map((s) => s[0]).join('')}</span><em class="mono">Winner photo</em><strong class="mono">Verified</strong></div>
            <figcaption><b class="d">{w.name}</b><span>{w.prize}</span><small class="mono">Ticket {w.ticket}</small></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section class="sec" style="padding-top:24px">
    <div class="wrap">
      <div class="sec-head"><div><span class="kick">Three darts</span><h2 class="d"><span class="sl">How it</span> <span class="sl g">works</span></h2></div></div>
      <div class="steps">
        {steps.map((s) => (
          <div class="panel step">
            <span class="bgnum d" aria-hidden="true">{s.n}</span>
            <svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="26" fill="#0F120F" stroke="#15D46B" stroke-width="2" /><circle cx="28" cy="28" r="17" fill="none" stroke="#FF3B3B" stroke-width="3" stroke-dasharray="6 4" /><circle cx="28" cy="28" r="6" fill="#15D46B" /><path d="M30 26 L50 6" stroke="#E4E4E7" stroke-width="3" stroke-linecap="round" /><path d="M46 4 L54 2 L52 10 Z" fill="#FFC83D" /></svg>
            <h3 class="d">{s.t}</h3>
            <p class="muted">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FREE ENTRY + CLUB -->
  <section class="sec" style="padding-top:0">
    <div class="wrap duo">
      <div class="panel free">
        <span class="kick" style="color:#a7f3d0;border-color:rgba(167,243,208,.4)">No purchase necessary</span>
        <h2 class="d"><span class="sl">Enter free</span> <span class="sl" style="color:#4ade80">by post</span></h2>
        <p>Every comp. Same random ticket, same chance as paid. No limit per person.</p>
        <a class="btn btn-white btn-sm" href={href('free-entry')}>How to enter by post</a>
      </div>
      <div class="panel club">
        <span class="kick">Join the club</span>
        <h2 class="d"><span class="sl">Codes before</span> <span class="sl gold">anyone else</span></h2>
        <form id="club"><label for="em" class="sr">Email address</label><input id="em" type="email" placeholder="Your email" required /><button class="btn btn-green btn-sm" type="submit">Get early access</button></form>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var show = document.querySelector('[data-show]'); if (!show) return;
    var slides = show.querySelectorAll('[data-slide]'), thumbs = show.querySelectorAll('[data-go]'), i = 0;
    function go(n) {
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, k) { s.classList.toggle('is-on', k === i); s.setAttribute('aria-hidden', k === i ? 'false' : 'true'); });
      thumbs.forEach(function (t, k) { t.classList.remove('on'); void t.offsetWidth; t.classList.toggle('on', k === i); });
      if (window.V9 && window.V9.burst) window.V9.burst(show, 1600);
    }
    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { go(+t.dataset.go); });
      t.querySelector('.tbar').addEventListener('animationend', function () { if (t.classList.contains('on')) go(i + 1); });
    });
    show.querySelectorAll('[data-step]').forEach(function (b) { b.addEventListener('click', function () { go(i + +b.dataset.step); }); });
    setTimeout(function () { if (window.V9 && window.V9.burst) window.V9.burst(show, 3200); }, 200);
  })();
</script>

<script is:inline define:vars={{ quickPool }}>
  // Category filter
  document.querySelectorAll('[data-filter]').forEach(function (b) {
    b.addEventListener('click', function () {
      var f = b.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      document.querySelectorAll('#grid > article').forEach(function (card) { card.hidden = !(f === 'All' || card.dataset.cat === f); });
    });
  });
  // Quick pick
  var amt = 10, picks = [];
  function money(v) { return '£' + v.toFixed(2); }
  function spread() {
    var left = amt, n = quickPool.map(function () { return 0; }), moved = true;
    while (moved) { moved = false; quickPool.forEach(function (c, i) { if (left + 1e-9 >= c.price) { n[i]++; left -= c.price; moved = true; } }); }
    picks = quickPool.map(function (c, i) { return { c: c, n: n[i] }; }).filter(function (p) { return p.n > 0; });
    document.getElementById('qp-budget').textContent = '£' + amt;
    document.getElementById('qp-list').innerHTML = picks.map(function (p) {
      var odds = p.c.max ? p.n + ' in ' + p.c.max.toLocaleString('en-GB') : p.n + ' instant spins';
      return '<li><b class="d">×' + p.n + '</b><div><strong>' + p.c.title + '</strong><small class="mono muted">' + odds + '</small></div><span class="mono">' + money(p.n * p.c.price) + '</span></li>';
    }).join('');
    document.getElementById('qp-tix').textContent = n.reduce(function (a, b) { return a + b; }, 0) + ' tickets';
    document.getElementById('qp-spent').textContent = money(amt - left);
  }
  document.querySelectorAll('[data-amt]').forEach(function (b) {
    b.addEventListener('click', function () {
      amt = parseInt(b.dataset.amt, 10);
      document.querySelectorAll('[data-amt]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      spread();
    });
  });
  document.getElementById('qp-add').addEventListener('click', function () {
    picks.forEach(function (p) { window.V9.add(p.c.slug, p.c.title, p.c.price, p.n); });
    window.V9.toast('Spread added to your basket');
  });
  spread();
  document.getElementById('club').addEventListener('submit', function (e) { e.preventDefault(); window.V9.toast("You're on the list. Codes coming soon."); e.target.reset(); });
</script>

<style>
  /* ---------- Main stage hero ---------- */
  .show { position: relative; overflow: hidden; padding: 34px 0 120px; background: radial-gradient(70% 55% at 50% 0%, rgba(0, 176, 80, .22), transparent 70%), linear-gradient(180deg, #030503, #050805 55%, #020302); }
  .s-bg { position: absolute; inset: 0; pointer-events: none; }
