---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, asset } from '../lib/url';
interface Props { title: string; description?: string; active?: string }
const { title, description = 'Win premium darts gear. Tickets from 25p, instant wins, and a public proof for every draw. Free postal entry on every competition.', active } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Vault Nine Competitions</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#050505" />
  <link rel="icon" href={asset('logo.png')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header active={active} />
  <main id="main"><slot /></main>
  <Footer />

  <a class="vip" href="https://chat.whatsapp.com/">
    <span class="dot"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#04140B" stroke-width="2.4" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.3-4.4A9 9 0 1 1 21 12z" /></svg></span>
    VIP group <small class="mono">Codes inside</small>
  </a>

  <nav class="tabbar" aria-label="App">
    <a href={href('')}>Home</a>
    <a href={href('competitions')}>Comps</a>
    <a href={href('competitions') + '#instant'} class="is-gold">Instant</a>
    <a href={href('winners')}>Winners</a>
    <a href={href('basket')}>Basket <span class="mono" data-basket-count>0</span></a>
  </nav>

  <div class="toast" role="status" aria-live="polite" hidden></div>

  <script is:inline>
    // Tiny basket store for the preview. In production this is the Laravel basket API.
    (function () {
      var KEY = 'v9-basket';
      function read() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return window.__v9b || []; } }
      function write(items) { window.__v9b = items; try { localStorage.setItem(KEY, JSON.stringify(items)); } catch (e) {} render(); }
      function count() { return read().reduce(function (t, i) { return t + i.qty; }, 0); }
      function render() { var n = count(); document.querySelectorAll('[data-basket-count]').forEach(function (el) { el.textContent = n; }); document.dispatchEvent(new CustomEvent('v9:basket')); }
      var toastEl, toastT;
      function toast(msg) { toastEl = toastEl || document.querySelector('.toast'); toastEl.textContent = msg; toastEl.hidden = false; clearTimeout(toastT); toastT = setTimeout(function () { toastEl.hidden = true; }, 2600); }
      window.V9 = {
        items: read,
        add: function (slug, title, price, qty) {
          var items = read(), it = items.find(function (i) { return i.slug === slug; });
          if (it) it.qty += qty; else items.push({ slug: slug, title: title, price: price, qty: qty });
          write(items); toast(qty + ' × ' + title + ' added · held 15 min');
        },
        set: function (slug, qty) { var items = read().map(function (i) { if (i.slug === slug) i.qty = qty; return i; }).filter(function (i) { return i.qty > 0; }); write(items); },
        clear: function () { write([]); },
        toast: toast
      };
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-add]'); if (!b) return;
        e.preventDefault();
        window.V9.add(b.dataset.add, b.dataset.title, parseFloat(b.dataset.price), parseInt(b.dataset.qty || '1', 10));
      });
      if (!read().length) write([{ slug: 'pick-your-board', title: 'Pick your board', price: 0.29, qty: 2 }]); else render();

      // Pyro: fill [data-gerb] fountains and [data-embers] fields with spark elements.
      var small = window.matchMedia('(max-width: 760px)').matches;
      var r = function (a, b) { return a + Math.random() * (b - a); };
      document.querySelectorAll('[data-gerb]').forEach(function (g) {
        var n = small ? 22 : 40, html = '';
        for (var i = 0; i < n; i++) html += '<i style="--a:' + r(-14, 14).toFixed(1) + 'deg;--h:' + r(180, 380).toFixed(0) + 'px;--dur:' + r(.7, 1.3).toFixed(2) + 's;--del:-' + r(0, 1.3).toFixed(2) + 's;--l:' + r(10, 22).toFixed(0) + 'px;--w:' + (Math.random() < .3 ? 3 : 2) + 'px"></i>';
        g.innerHTML = html;
      });
      document.querySelectorAll('[data-embers]').forEach(function (f) {
        var n = small ? 18 : +(f.dataset.embers || 40), html = '';
        for (var i = 0; i < n; i++) html += '<i style="--x:' + r(0, 100).toFixed(1) + '%;--dx:' + r(-80, 80).toFixed(0) + 'px;--rise:' + r(380, 900).toFixed(0) + 'px;--dur:' + r(4, 9).toFixed(1) + 's;--del:-' + r(0, 9).toFixed(1) + 's;--o:' + r(.35, .95).toFixed(2) + ';--w:' + r(2, 4).toFixed(1) + 'px;--l:' + r(3, 20).toFixed(0) + 'px"></i>';
        f.innerHTML = html;
      });
      window.V9.burst = function (scope, ms) {
        var gs = (scope || document).querySelectorAll('[data-gerb]');
        gs.forEach(function (g) { g.classList.add('burst'); clearTimeout(g._t); g._t = setTimeout(function () { g.classList.remove('burst'); }, ms || 2200); });
      };
    })();
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: #fff; color: #000; padding: 10px 14px; border-radius: 8px; }
  .skip:focus { left: 8px; }
  .vip { position: fixed; right: 20px; bottom: 20px; z-index: 40; display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 18px 0 8px; border-radius: 999px; background: #0a0c0a; border: 1px solid rgba(21, 212, 107, .5); color: #fff; box-shadow: 0 20px 50px -10px rgba(0, 0, 0, .8); font: 400 16px var(--font-display); letter-spacing: .05em; text-transform: uppercase; }
  .vip:hover { color: #fff; border-color: var(--green-hi); }
  .vip .dot { width: 38px; height: 38px; border-radius: 50%; background: var(--green); display: inline-flex; align-items: center; justify-content: center; }
  .vip small { font-size: 11px; color: var(--green-soft); }
  .toast { position: fixed; left: 50%; bottom: 88px; transform: translateX(-50%); z-index: 50; padding: 14px 20px; border-radius: 14px; background: #0f120f; border: 1px solid var(--green-hi); color: #fff; font-weight: 700; box-shadow: 0 20px 60px -10px rgba(0, 176, 80, .6); }
  .toast[hidden] { display: none; }
  .tabbar { display: none; }
  @media (max-width: 760px) {
    .vip { bottom: 84px; right: 12px; }
    .vip small { display: none; }
    .tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; background: #070907; border-top: 1px solid rgba(21, 212, 107, .25); padding-bottom: env(safe-area-inset-bottom); }
    .tabbar a { flex: 1; display: flex; align-items: center; justify-content: center; gap: 4px; min-height: 60px; color: var(--muted); font: 400 13px var(--font-display); letter-spacing: .06em; text-transform: uppercase; }
    .tabbar a.is-gold { color: var(--gold); }
    :global(body) { padding-bottom: 60px; }
  }
</style>
